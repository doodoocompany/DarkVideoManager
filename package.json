{
  "name": "dark-video-manager",
  "version": "0.3.5",
  "private": true,
  "description": "Windows 로컬 동영상 라이브러리 매니저",
  "license": "MIT",
  "author": "DarkVideoManager Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/DarkVideoManager/DarkVideoManager.git"
  },
  "engines": {
    "node": "^24.18.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "setup:media": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-media.ps1",
    "setup:subtitles": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-subtitles.ps1",
    "setup:subtitles:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-subtitles-gpu.ps1",
    "dev": "chcp 65001 && electron-vite dev",
    "dev:web": "vite dev --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:win": "npm run build && npm run licenses:check && electron-builder --win --publish never && node scripts/stage-update-assets.cjs && node scripts/smoke-app-updates.cjs dist-electron/win-unpacked/DarkVideoManager.exe",
    "build:unpacked": "npm run build && npm run licenses:generate && electron-builder --win --dir --publish never",
    "licenses:generate": "node scripts/generate-third-party-notices.cjs",
    "licenses:check": "node scripts/generate-third-party-notices.cjs --check-release",
    "audit:publication": "node scripts/audit-publication.cjs --history",
    "export:source": "node scripts/export-source.cjs",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "verify:runtime": "node scripts/verify-native.cjs",
    "test": "node scripts/run-tests.cjs",
    "test:tooling": "node --test \"scripts/*.test.cjs\"",
    "test:e2e": "playwright test",
    "test:electron": "node scripts/smoke-electron.cjs && node scripts/smoke-app-updates.cjs",
    "test:native": "node scripts/smoke-native.cjs",
    "benchmark:search": "node scripts/benchmark-search.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.15",
    "better-sqlite3": "13.0.3",
    "chardet": "^2.2.0",
    "electron-updater": "6.8.10",
    "fluent-ffmpeg": "^2.1.3",
    "iconv-lite": "^0.7.3",
    "lazy-val": "file:vendor/lazy-value-compat",
    "pino": "^10.4.0",
    "plyr": "^3.8.5",
    "react-router-dom": "7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "lazy-val": "$lazy-val"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^19.2.2",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.45.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@types/better-sqlite3": "^7.6.10",
    "@types/chardet": "^0.8.3",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.6.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fengari": "^0.1.5",
    "husky": "^9.0.11",
    "jimp": "^1.6.1",
    "lint-staged": "17.6.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.4.5",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
